#!/usr/bin/env python3
"""Launcher for the Green Vibe validators.

Runs the green_vibe package in place - no installation, stdlib only.
Usage: python3 <plugin>/validators/green-vibe <command> [args]
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from green_vibe.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
